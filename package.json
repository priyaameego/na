{
  "name": "nayara-industries-premium",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "generate": "node generate_pages.js",
    "build": "npm run build:css && npm run generate",
    "db:init": "node server/init-db.js",
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "vercel-build": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
